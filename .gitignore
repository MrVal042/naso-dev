# Installed to develop and test this package, never committed.
node_modules/

# `npm pack` output.
*.tgz

# A vendored NASO install, if this repository is ever set up with itself. Root only:
# examples/ commits what NASO wrote for each example.
/.naso/
# No dependencies, so nothing to lock. npm writes one on `npm install` anyway. Root only:
# the examples keep theirs, because NASO reads a lockfile to name the package manager.
/package-lock.json
